{
  "name": "Agente Revisor de PRs - GitHub Integration",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "github-pr-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "github-trigger",
      "name": "GitHub Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.action }}",
              "operation": "equals",
              "value2": "opened"
            },
            {
              "value1": "={{ $json.body.action }}",
              "operation": "equals",
              "value2": "synchronize"
            }
          ]
        }
      },
      "id": "filter-events",
      "name": "Filter PR Events",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "repo_url",
              "value": "={{ $json.body.repository.html_url }}"
            },
            {
              "name": "pr_number",
              "value": "={{ $json.body.pull_request.number }}"
            },
            {
              "name": "pr_title",
              "value": "={{ $json.body.pull_request.title }}"
            },
            {
              "name": "pr_author",
              "value": "={{ $json.body.pull_request.user.login }}"
            },
            {
              "name": "action",
              "value": "={{ $json.body.action }}"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-data",
      "name": "Extract PR Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "command": "={{ 'python main.py ' + $json.repo_url + ' --dry-run 2>&1' }}"
      },
      "id": "execute-agent",
      "name": "Execute PR Review Agent",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo_url.split('/')[3] }}/{{ $json.repo_url.split('/')[4] }}/pulls/{{ $json.pr_number }}/reviews",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ '🤖 **Agente Revisor de PRs**\\n\\n**PR #' + $json.pr_number + ':** ' + $json.pr_title + '\\n\\n**Análise Automática:**\\n\\n' + $json.stdout }}"
            },
            {
              "name": "event",
              "value": "COMMENT"
            }
          ]
        },
        "options": {}
      },
      "id": "post-review",
      "name": "Post Review to GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1050, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "github-token",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'success', pr_number: $json.pr_number, message: 'Review posted successfully' }) }}"
      },
      "id": "response-success",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'error', message: $json.stderr || 'Agent execution failed' }) }}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "response-error",
      "name": "Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 500]
    }
  ],
  "connections": {
    "GitHub Webhook Trigger": {
      "main": [
        [
          {
            "node": "Filter PR Events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter PR Events": {
      "main": [
        [
          {
            "node": "Extract PR Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract PR Data": {
      "main": [
        [
          {
            "node": "Execute PR Review Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute PR Review Agent": {
      "main": [
        [
          {
            "node": "Post Review to GitHub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post Review to GitHub": {
      "main": [
        [
          {
            "node": "Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}