# Token de acesso pessoal do GitHub (com permissão para repositórios)
# Criar em: https://github.com/settings/tokens
# Escopos necessários: repo (para acessar PRs e postar comentários)
GITHUB_TOKEN=seu_token_aqui

# Provedor LLM primário (opcional)
# Valores: gemini (padrao) | openrouter
# - gemini    → tenta Gemini primeiro, OpenRouter como fallback
# - openrouter→ tenta OpenRouter primeiro, Gemini como fallback
LLM_PRIMARY_PROVIDER=gemini

# Chave da API Google Gemini
# Obter em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=sua_chave_aqui
# Modelo do Gemini (opcional — padrao: gemini-3.6-flash)
GOOGLE_MODEL=gemini-3.6-flash

# Chave da API OpenRouter (alternativa gratis ao Gemini)
# Obter em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sua_chave_aqui
# Modelo padrao do OpenRouter (gratuito)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
